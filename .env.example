# Copy to .env.local for local dev. On Vercel, set these under Project → Settings → Environment Variables.

# Postgres connection string (Neon). The Vercel ↔ Neon marketplace integration injects this automatically.
# Local dev without Neon: DATABASE_URL=pglite://./.pglite (embedded Postgres in that folder).
DATABASE_URL=

# Anthropic API key for generation, glosses, "why?" explanations, and produce-grading.
ANTHROPIC_API_KEY=

# Base URL of the separately deployed spaCy NLP service (Fly.io / Railway), e.g. https://lode-nlp.fly.dev
NLP_SERVICE_URL=
# Shared secret the Next.js app sends as a bearer token so the NLP service isn't open to the world.
NLP_SERVICE_TOKEN=

# Sign-in with the Done Intentionally suite account (the suite's shared Supabase project).
# Leave both unset and the app is open, acting as one local user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Who may use Dolomite: comma-separated emails. Empty lets nobody in.
ALLOWED_EMAILS=
# Production only: .doneintentionally.com shares the sign-in across the suite. Leave unset locally and on previews.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Optional: base URL for Google and email-confirmation redirects (defaults to the request's origin).
NEXT_PUBLIC_SITE_URL=
